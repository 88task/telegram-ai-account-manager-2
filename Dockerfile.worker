# syntax=docker/dockerfile:1
FROM node:20-alpine AS builder

WORKDIR /app
RUN npm install -g pnpm

COPY package.json pnpm-workspace.yaml ./
COPY tsconfig.json ./
COPY packages/db/package.json packages/db/
COPY packages/brain/package.json packages/brain/
COPY packages/worker/package.json packages/worker/

RUN pnpm install --no-frozen-lockfile

COPY packages/db packages/db
COPY packages/brain packages/brain
COPY packages/worker packages/worker

RUN pnpm --filter @telegram-ai/db build
RUN pnpm --filter @telegram-ai/brain build
RUN pnpm --filter @telegram-ai/worker build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN npm install -g pnpm

COPY package.json pnpm-workspace.yaml ./
COPY packages/db/package.json packages/db/
COPY packages/brain/package.json packages/brain/
COPY packages/worker/package.json packages/worker/

RUN pnpm install --prod --no-frozen-lockfile --ignore-scripts

COPY --from=builder /app/packages/db/dist packages/db/dist
COPY --from=builder /app/packages/brain/dist packages/brain/dist
COPY --from=builder /app/packages/worker/dist packages/worker/dist

CMD ["node", "packages/worker/dist/index.js"]

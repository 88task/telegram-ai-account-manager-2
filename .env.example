# AWS RDS PostgreSQL Connection
DATABASE_URL=postgresql://postgres:password@your-rds-host.rds.amazonaws.com:5432/telegram_ai?sslmode=require

# AWS Bedrock Configuration (Vision & Multimodal AI)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# Amazon Nova Pro (Multimodal: Images, Screenshots & Text)
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_TEMPERATURE=0.4
BEDROCK_MAX_TOKENS=1024

# Telegram MTProto Account Credentials (from my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_PHONE=+1234567890
SESSION_ENCRYPTION_KEY=generate_a_random_32_byte_secret_here

# Operating Mode & Guardrails
# manual | draft | auto_pilot
OPERATING_MODE=draft
AUTO_PILOT_CONFIDENCE_THRESHOLD=0.85

# Safety & Scope Filters (comma-separated IDs)
# Keep ALLOWED_GROUP_IDS empty to ignore all groups and channels by default
ALLOWED_GROUP_IDS=
BLOCKED_USER_IDS=

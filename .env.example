# AWS RDS PostgreSQL Connection
DATABASE_URL=postgresql://postgres:password@your-rds-host.rds.amazonaws.com:5432/telegram_ai

# AWS Bedrock Authentication
AWS_REGION=ap-south-1

# Option A: Single Bedrock API Key (from Amazon Bedrock Console -> API keys)
AWS_BEARER_TOKEN_BEDROCK=
# or BEDROCK_API_KEY=

# Option B: Standard AWS IAM Credentials (alternative to API key)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon Bedrock Models (Multimodal Vision & Fast Perception)
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_FAST_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_TEMPERATURE=0.3
BEDROCK_MAX_TOKENS=1024

# Telegram MTProto Account Credentials (from my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_PHONE=+1234567890
# Generate using: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=

# Operating Mode & Guardrails (manual | draft | auto_pilot)
DEFAULT_OPERATING_MODE=draft
AUTO_PILOT_CONFIDENCE_THRESHOLD=0.85

# Safety & Scope Filters (comma-separated Telegram IDs)
# Keep ALLOWED_GROUP_IDS empty to ignore all groups and channels by default
ALLOWED_GROUP_IDS=
BLOCKED_USER_IDS=

# Panel authentication (required; serve through an HTTPS reverse proxy)
# Optional external origin when a proxy rewrites Host (e.g. https://panel.example.com)
PANEL_ORIGIN=
PANEL_USERNAME=
# Use a unique random password, minimum 16 characters
PANEL_PASSWORD=

# Database connections use TLS encryption without server certificate verification.
# No database CA environment variable or SSM certificate secret is required.

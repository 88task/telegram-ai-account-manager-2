{
  "name": "telegram-ai-account-manager",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "worker:auth": "pnpm --filter @telegram-ai/worker auth",
    "worker:start": "pnpm --filter @telegram-ai/worker start",
    "db:push": "pnpm --filter @telegram-ai/db push",
    "db:studio": "pnpm --filter @telegram-ai/db studio",
    "web:dev": "pnpm --filter @telegram-ai/web dev",
    "web:start": "pnpm --filter @telegram-ai/web start",
    "web:build": "pnpm --filter @telegram-ai/web build",
    "test": "pnpm build && node --test tests/*.test.cjs tests/*.test.mjs",
    "test:integration": "pnpm build && node --test tests/integration/*.test.cjs"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bufferutil",
      "utf-8-validate",
      "es5-ext",
      "esbuild"
    ]
  }
}

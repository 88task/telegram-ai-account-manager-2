{
  "name": "@telegram-ai/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/public', 'dist/public', { recursive: true })\"",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@telegram-ai/brain": "workspace:*",
    "@telegram-ai/db": "workspace:*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "express": "^4.21.0",
    "telegram": "^2.22.2",
    "@telegram-ai/worker": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
